{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "~/*": ["./app/*"],
      "*": ["./*"]
    },
    "declaration": false,
    "noEmit": true
  },
  "include": ["app"],
  "exclude": ["**/+types/**"]
}
