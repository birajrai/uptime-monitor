# Environment Variables
# Copy this file to .env and fill in your values

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Secret key for signing session cookies (generate a random 64-char string)
APP_SECRET=replace-with-a-random-64-character-string

# Optional: API key to protect the cron endpoint
CRON_API_KEY=replace-with-a-random-key
